    "actionDeprecations": {
      "go": "watcher.ActionDeprecations",
      "cases": [
        {
          "name": "notify given=true",
          "input": {
            "action": "notify",
            "action_given": true
          },
          "output": [
            {
              "id": "action-notify",
              "message": "--action notify is deprecated and will be removed in a later release. A notify watch only checks that the instance type is offered in the region at or under your max price, not a capacity check: it launches and reserves nothing, and for a scarce type it can fire while a real launch fails with InsufficientInstanceCapacity.\nUse instead:\n  --action hold   reserves the capacity when it is found: a targeted On-Demand Capacity Reservation for 30 minutes, billed at the On-Demand rate from the moment it is held, even if unused.\n  --action spawn  launches the instance when it is found (needs --spawn-config): the launch is the capacity test, and the instance bills until its TTL."
            }
          ]
        },
        {
          "name": "notify given=false",
          "input": {
            "action": "notify",
            "action_given": false
          },
          "output": [
            {
              "id": "action-notify",
              "message": "no --action given, so this is a notify watch (deprecated); pass --action explicitly.\n--action notify is deprecated and will be removed in a later release. A notify watch only checks that the instance type is offered in the region at or under your max price, not a capacity check: it launches and reserves nothing, and for a scarce type it can fire while a real launch fails with InsufficientInstanceCapacity.\nUse instead:\n  --action hold   reserves the capacity when it is found: a targeted On-Demand Capacity Reservation for 30 minutes, billed at the On-Demand rate from the moment it is held, even if unused.\n  --action spawn  launches the instance when it is found (needs --spawn-config): the launch is the capacity test, and the instance bills until its TTL."
            }
          ]
        },
        {
          "name": "spawn given=true",
          "input": {
            "action": "spawn",
            "action_given": true
          },
          "output": []
        },
        {
          "name": "spawn given=false",
          "input": {
            "action": "spawn",
            "action_given": false
          },
          "output": []
        },
        {
          "name": "hold given=true",
          "input": {
            "action": "hold",
            "action_given": true
          },
          "output": []
        },
        {
          "name": "hold given=false",
          "input": {
            "action": "hold",
            "action_given": false
          },
          "output": []
        }
      ]
